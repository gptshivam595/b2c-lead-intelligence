# Environment Configuration Example (NO SECRETS HERE)
# In Google AI Studio Build, the Gemini API key is automatically provided via the
# server-side secret named "skillcase api" or "GEMINI_API_KEY".

# Server Port (Default: 3000)
PORT=3000

# Node Environment ('development' or 'production')
NODE_ENV=development

# Gemini API Key (Optional local fallback for self-hosted execution outside AI Studio)
# GEMINI_API_KEY=your_gemini_api_key_here
